# Admin Clerk instance — SEPARATE from the customer pool (PRD-02 §4A).
# Login-only (no signup), MFA enforced at the instance level. Create a NEW Clerk
# application for staff; do not reuse the customer keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# lince-backend (lince-phase1). Server-to-server admin calls.
LINCE_API_URL=http://localhost:3000

# Shared secret with the backend's ADMIN_SERVICE_TOKEN — must match exactly.
ADMIN_SERVICE_TOKEN=change-me
